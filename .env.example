AUTH_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# POSTGRES_URL=
RESEND_API_KEY=
EMAIL_FROM="enone.app <noreply@enone.app>"
ADMIN_NOTIFY_EMAIL=
NEXT_PUBLIC_APP_URL=https://enone.app
# Vercel Blob (public media URLs for Facebook/Instagram). Auto-set when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Scheduled social publishing (Vercel Cron → /api/cron/publish sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Meta (optional): enables "convert user token → permanent Page token" in Integraciones and richer token checks
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v26.0

# Stripe (one-time Checkout for enone subscription)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Orders API create + capture)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI Smart Agent (OpenAI-compatible preferred; Anthropic fallback if no OpenAI key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
